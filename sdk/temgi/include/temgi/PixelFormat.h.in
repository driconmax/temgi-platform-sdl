#pragma once

#include <cstdint>

// Generated by CMake from PixelFormat.h.in - do not edit include/temgi/PixelFormat.h by hand.
namespace temgi
{
    enum class PixelFormat : std::uint8_t
    {
        Indexed8 = 0, // 1 byte/pixel, palette-indexed (low memory console)
        RGB565 = 1,   // 2 bytes/pixel, direct truecolor (full color console)
    };

#cmakedefine TEMGI_PIXEL_RGB565

#if defined(TEMGI_PIXEL_RGB565)
    using PixelStorage = std::uint16_t;
    constexpr PixelFormat CONSOLE_PIXEL_FORMAT = PixelFormat::RGB565;
#else
    using PixelStorage = std::uint8_t;
    constexpr PixelFormat CONSOLE_PIXEL_FORMAT = PixelFormat::Indexed8;
#endif
} // namespace temgi
